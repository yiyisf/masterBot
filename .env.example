# Server
PORT=3000
HOST=0.0.0.0

# LLM Configuration
DEFAULT_LLM_PROVIDER=openai

# OpenAI Compatible API
OPENAI_BASE_URL=http://ai-gateway.internal/v1
OPENAI_API_KEY=your-internal-api-key
OPENAI_MODEL=gpt-4

# Anthropic Compatible API
ANTHROPIC_BASE_URL=http://ai-gateway.internal/anthropic
ANTHROPIC_API_KEY=your-anthropic-key
ANTHROPIC_MODEL=claude-3-sonnet-20240229

# Redis (for BullMQ)
REDIS_URL=redis://localhost:6379

# Vector Database
CHROMA_URL=http://localhost:8000

# Logging
LOG_LEVEL=info

# GitHub（研发流程管理模块：需求同步，可选，公开仓库可不设置）
GITHUB_TOKEN=

# Next Architecture Workspace (Slice 0)
CMASTER_SERVER_ROLE=all
CMASTER_API_PORT=3100
CMASTER_WEB_ORIGIN=http://localhost:3101
DATABASE_URL=postgresql://cmaster:cmaster_dev@localhost:5432/cmaster_next
NEXT_ARCHITECTURE_ENABLED=false
CMASTER_RUNTIME_ENV=development
CMASTER_DEVELOPMENT_IDENTITY_ENABLED=false
CMASTER_DEV_ORGANIZATION_ID=00000000-0000-4000-8000-000000000001
CMASTER_DEV_PRINCIPAL_ID=00000000-0000-4000-8000-000000000002
CMASTER_DEV_PRINCIPAL_DISPLAY_NAME=Development Employee
CMASTER_DEV_AGENT_ID=00000000-0000-4000-8000-000000000003
CMASTER_DEV_AGENT_REVISION_ID=00000000-0000-4000-8000-000000000004

# AI SDK Runtime (Slice 2, optional; Echo remains the default when disabled)
CMASTER_AI_SDK_RUNTIME_ENABLED=false
CMASTER_TOOL_RUNTIME_ENABLED=false
CMASTER_CONTEXT_ARTIFACTS_ENABLED=false
# Requires the complete Context & Artifacts runtime; mounts historical Slice 5 Experience routes.
CMASTER_EMPLOYEE_WORKSPACE_ENABLED=false
# Mounts Principal-private Filesystem Workspace Catalog routes.
CMASTER_FILESYSTEM_WORKSPACE_ENABLED=false
CMASTER_ARTIFACT_STORAGE_ROOT=data/artifacts
# Comma-separated hostnames only. Empty keeps the HTTPS fetch Tool unable to dispatch.
CMASTER_HTTP_FETCH_ALLOWED_HOSTS=
CMASTER_DEV_AI_AGENT_REVISION_ID=00000000-0000-4000-8000-000000000005
# Tool Runtime activates separate immutable Agent/Model revisions.
CMASTER_DEV_TOOL_AGENT_REVISION_ID=00000000-0000-4000-8000-000000000012
# Context & Artifacts activates another immutable Agent Revision.
CMASTER_DEV_CONTEXT_ARTIFACT_AGENT_REVISION_ID=00000000-0000-4000-8000-000000000015
CMASTER_PRIMARY_MODEL_PROFILE_ID=00000000-0000-4000-8000-000000000006
CMASTER_TOOL_MODEL_PROFILE_ID=00000000-0000-4000-8000-000000000013
CMASTER_CONTEXT_PRIMARY_MODEL_PROFILE_ID=00000000-0000-4000-8000-000000000016
CMASTER_PRIMARY_MODEL_DISPLAY_NAME=Development Primary Model
CMASTER_PRIMARY_MODEL_BASE_URL=https://api.openai.com/v1
CMASTER_PRIMARY_MODEL_ID=gpt-4.1-mini
CMASTER_PRIMARY_MODEL_API_KEY=
# Required only when Context & Artifacts is enabled.
CMASTER_PRIMARY_MODEL_CONTEXT_WINDOW_TOKENS=
CMASTER_PRIMARY_MODEL_MAX_OUTPUT_TOKENS=16384
# Fallback must be either completely configured or completely absent.
CMASTER_FALLBACK_MODEL_PROFILE_ID=00000000-0000-4000-8000-000000000007
CMASTER_TOOL_FALLBACK_MODEL_PROFILE_ID=00000000-0000-4000-8000-000000000014
CMASTER_CONTEXT_FALLBACK_MODEL_PROFILE_ID=00000000-0000-4000-8000-000000000017
CMASTER_FALLBACK_MODEL_DISPLAY_NAME=Development Fallback Model
CMASTER_FALLBACK_MODEL_BASE_URL=
CMASTER_FALLBACK_MODEL_ID=
CMASTER_FALLBACK_MODEL_API_KEY=
# Required only when both Fallback and Context & Artifacts are enabled.
CMASTER_FALLBACK_MODEL_CONTEXT_WINDOW_TOKENS=
CMASTER_FALLBACK_MODEL_MAX_OUTPUT_TOKENS=16384

CMASTER_WORKER_LEASE_TTL_MS=30000
CMASTER_WORKER_POLL_INTERVAL_MS=500
CMASTER_WORKER_MAX_ATTEMPTS=5
CMASTER_WORKER_CONCURRENCY=4
# Browser defaults to same-origin /api/v1. Override only for explicit cross-origin tests.
NEXT_PUBLIC_CMASTER_API_URL=
# Next.js development rewrite target; this is transport-only and not a BFF.
CMASTER_API_ORIGIN=http://localhost:3100
